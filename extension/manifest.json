{
  "manifest_version": 3,
  "name": "Bulk Buddy for Notion",
  "version": "1.0.0",
  "description": "Cross-workspace find & replace and bulk property editing for Notion, via the official API — right in your browser.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "dist/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "dist/service-worker.js",
    "type": "module"
  },
  "host_permissions": [
    "https://api.notion.com/*",
    "https://extensionpay.com/*"
  ],
  "permissions": ["storage", "identity"]
}
