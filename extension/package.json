{
  "name": "@deva/notion-extension",
  "version": "1.0.0",
  "private": true,
  "description": "Bulk Buddy for Notion (dev) - MV3 extension connection spike",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "node -e \"import('node:fs').then(fs=>fs.rmSync('dist',{recursive:true,force:true}))\""
  },
  "dependencies": {
    "extpay": "^3.1.2",
    "preact": "^10.25.4"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "esbuild": "^0.21.5",
    "typescript": "^5.4.5",
    "vitest": "^4.1.10"
  }
}
